! B3LYP 6-31+g** 

        %scf Convergence verytight
        maxiter 300 end
        %maxcore 2000
        %pal nprocs 1 end

        %method
        Grid        2
        FinalGrid   4
        end

        %output
        Print[ P_Hirshfeld] 1
        Print[ P_Mayer] 1
        end

        %plots
